{
  "version": "cancellation-unit-routing/1.0-draft",
  "appliesTo": "CANCELLATION",
  "input": "originalFileName",
  "context": "已验证为退单手术信息查询导出；判断文件所属手术室",
  "units": [
    {"code": "OR_1", "display": "一号手术室", "aliases": ["第一手术室", "一手", "一手退单"]},
    {"code": "OR_2", "display": "二号手术室", "aliases": ["第二手术室", "二手", "二手退单"]},
    {"code": "OR_3", "display": "三号手术室", "aliases": ["第三手术室", "三手", "三手退单"]}
  ],
  "normalization": {
    "stripExtension": true,
    "stripDateRangeAndCopyMarkers": true,
    "normalizeWhitespaceAndWidth": true,
    "preserveUnitNumberTokens": true
  },
  "matching": {
    "exactAlias": "unique-equality-after-normalization-accepted",
    "semanticJudge": "constrained-chat-llm-compare-OR_1-OR_2-OR_3-or-abstain",
    "judgeOutput": ["candidateUnitCode", "fileNameEvidence", "conflictingEvidence", "decision"],
    "autoAccept": "unique-explicit-unit-number-evidence-and-no-conflict-after-labeled-case-validation",
    "fuzzyWithoutExplicitUnitNumber": "NEEDS_UNIT_CONFIRMATION",
    "optionalEmbedding": {
      "enabled": false,
      "embeddingTemplateForNameAndAlias": "退单文件所属手术室：{text}",
      "embeddingModelVersion": "TBD_IF_ADAPTER_ADDED",
      "minScore": null,
      "minTopTwoMargin": null,
      "thresholdPolicy": "calibrate-on-labeled-positive-and-negative-filenames-before-enabling"
    },
    "missingOrAmbiguous": "NEEDS_UNIT_CONFIRMATION",
    "roomCodeCheck": "audit-conflicts-only-not-primary-assignment"
  }
}
