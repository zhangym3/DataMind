        "operating_room": {"meaning": "来源的具体手术间", "filter": ["eq", "in"], "group": true},
        "inpatient_no": {"meaning": "住院号，不是手术唯一键", "sensitivity": "PERSONAL"},
        "patient_id": {"meaning": "来源患者 ID，不是跨表手术键", "sensitivity": "PERSONAL"},
        "patient_name": {"meaning": "患者姓名", "sensitivity": "PERSONAL"},
        "surgical_department": {"meaning": "来源手术科室", "filter": ["eq", "in"], "group": true},
